import cv2
import numpy as np

img = cv2.imread("image.jpg", cv2.IMREAD_GRAYSCALE)

gamma = float(input("Enter the value of gamma: "))

r = img.astype(float) / 255.0

power_image = r ** gamma

power_image = (power_image * 255).astype(np.uint8)

cv2.imshow("Original Image", img)
cv2.imshow("Power Law Transformed Image", power_image)

cv2.waitKey(0)
cv2.destroyAllWindows()
