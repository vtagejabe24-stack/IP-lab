import cv2
import numpy as np

img = cv2.imread("image.jpg")

B, G, R = cv2.split(img)

wr = float(input("Enter weightage of R: "))
wg = float(input("Enter weightage of G: "))
wb = float(input("Enter weightage of B: "))

if wr < 0 or wr > 1 or wg < 0 or wg > 1 or wb < 0 or wb > 1:
    print("Weightages must be between 0 and 1.")

elif abs((wr + wg + wb) - 1) > 0.0001:
    print("Sum of all weightages must be equal to 1.")

else:
    gray = (
        wr * R.astype(float) +
        wg * G.astype(float) +
        wb * B.astype(float)
    ).astype(np.uint8)

    cv2.imshow("Original RGB Image", img)
    cv2.imshow("Grayscale Image - Weighted", gray)

    cv2.waitKey(0)
    cv2.destroyAllWindows()
